# AegisAIDR 演示环境变量。复制为 env/demo.env 后按实际环境修改：
#   cp env/demo.env.example env/demo.env
# scripts/*.sh 会自动加载 env/demo.env（不存在则加载本示例的默认值）。

# ---- 演示项目 ----
DEMO_PROJECT="$HOME/aegis-demo/shop-api"
# 外链下载域名统一用 GitHub：投毒 README 中的初始化脚本托管在这个仓库
DEMO_REPO="yixuanzi/aegis-demo"
DEMO_BRANCH="main"
DEMO_RAW_BASE="https://raw.githubusercontent.com/${DEMO_REPO}/${DEMO_BRANCH}/scripts"

# ---- 探针（aegis-sensor）----
# 留空则使用 PATH 中的 aegis-sensor
AEGIS_SENSOR_BIN=""
# 本机 aegis-sensor server 的接收地址，replay.sh send 会写到这里
AEGIS_INGEST_URL="http://127.0.0.1:15799/v1/records"
# 内置规则目录，replay.sh check 的阻断检查用它生成 enforce 规则
# （AegisAIDR 源码仓库里的 rules/ 目录）
AEGIS_RULES_DIR="$HOME/workspace/AegisAIDR/rules"

# ---- 控制台（只用于文档和提示，脚本不会调用）----
AEGIS_CONSOLE_URL="https://aegis-console.example"
DEMO_GROUP="demo"
DEMO_RULESET="demo-block"
